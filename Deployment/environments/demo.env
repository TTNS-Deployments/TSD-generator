# Deployment variables for the DEMO environment, read by:  Deployment/scripts/deploy.sh -e demo
# Command-line options override these values. Do not put secrets in this file.

# Subscription ID or name. Empty = the subscription currently selected in `az account show`.
AZURE_SUBSCRIPTION=""

# Existing resource group for the demo. deploy.sh reuses it and never recreates it.
RESOURCE_GROUP="Vaibhav.Chaudhary"

# Region of the resource group. Must be the region of the shared App Service plan below.
LOCATION="centralindia"

# Naming, same convention as the other demo apps:
#   <solutionPrefix>-<environmentName>-<suffix>-web
#   suffix = take(uniqueString(resourceGroup().id, solutionPrefix, environmentName), 6)
SOLUTION_PREFIX="tsdgen"
ENVIRONMENT_NAME="demo"

# Tag "solution" on the web app (the "environment" tag is ENVIRONMENT_NAME)
SOLUTION_TAG="tsd-generator"

# Shared, existing Linux App Service plan that hosts the web app (a separate web app on the same plan).
# The plan is never modified.
EXISTING_PLAN_NAME="ccai-demo-gqausd-web-plan"
EXISTING_PLAN_RESOURCE_GROUP="Vaibhav.Chaudhary"

# GitHub repo whose releases hold the deployment package (built by .github/workflows/build.yml)
REPO="TTNS-Deployments/TSD-generator"
BRANCH="main"

# Java heap limit. The B1 plan (1.75 GB) is shared with the other demo apps.
JAVA_MAX_HEAP="384m"
